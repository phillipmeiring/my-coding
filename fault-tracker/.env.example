# Copy this file to .env and fill in real values to send fault-notification
# emails through a real SMTP provider instead of Ethereal's fake-SMTP testing
# service. If SMTP_HOST is unset (or .env doesn't exist), the app falls back
# to Ethereal automatically -- no configuration needed for local dev/testing.

# Required to enable real sending.
SMTP_HOST=

# Optional -- defaults shown.
SMTP_PORT=587
# "true" for port 465 (implicit TLS), "false" for STARTTLS on 587/others.
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Shown as the "From" address. Quote the display name if it contains spaces.
SMTP_FROM="Fault Tracker <no-reply@example.com>"
